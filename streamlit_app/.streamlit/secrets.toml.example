# Copy to .streamlit/secrets.toml for local testing (gitignored — never commit
# real credentials), OR paste this same key/value into the Streamlit Community
# Cloud dashboard under App settings -> Secrets when deploying. Locally, the
# app also falls back to the repo-root .env file automatically, so this file
# is optional on your own machine — it exists mainly to document the exact
# key Streamlit Cloud needs.

DATABASE_URL = "postgresql://postgres.your-project-ref:your_url_encoded_password@aws-0-your-region.pooler.supabase.com:5432/postgres"
