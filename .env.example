# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit actual credentials.

DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=customer_revenue_intelligence

# Supabase Postgres connection string. In the Supabase dashboard:
# "Connect" button -> "Direct Connection" tab -> switch mode to
# "Session pooler". Use the pooler string (not the direct db.xxx.supabase.co
# one) everywhere, including GitHub Actions secrets — the direct host
# resolves via IPv6 only on the free tier, which CI runners aren't
# guaranteed to support; the pooler (Supavisor) supports IPv4.
# If your password contains special characters (@, /, :, etc.), URL-encode
# them — e.g. "@" becomes "%40".
DATABASE_URL=postgresql://postgres.your-project-ref:your_url_encoded_password@aws-0-your-region.pooler.supabase.com:5432/postgres
